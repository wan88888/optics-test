#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Prefer an explicitly selected interpreter or the active Python environment.
if [[ -n "${OPTICS_PYTHON:-}" ]]; then
  python_bin="$OPTICS_PYTHON"
elif python3 -c 'import optics_framework' >/dev/null 2>&1; then
  python_bin="$(command -v python3)"
elif [[ -x "$HOME/.optics/venv/bin/python" ]]; then
  python_bin="$HOME/.optics/venv/bin/python"
else
  echo 'Set OPTICS_PYTHON to a Python interpreter with optics-framework installed.' >&2
  exit 1
fi
exec "$python_bin" "$project_dir/scripts/optics_runner.py" "$@"
